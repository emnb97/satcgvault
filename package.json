{
  "name": "satcgvault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "S&A TCG Vault Ltd — static storefront with Stripe Checkout on Netlify",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && npx netlify dev",
    "preview": "node scripts/build.mjs && npx serve dist",
    "doctor": "node scripts/doctor.mjs",
    "migrate": "node scripts/migrate-to-sanity.mjs",
    "migrate-consignments": "node scripts/migrate-consignments.mjs",
    "db:setup": "node scripts/db-setup.mjs",
    "test": "node --test-reporter=spec tests/inventory.test.mjs"
  },
  "dependencies": {
    "@sanity/client": "^6.22.0",
    "esbuild": "^0.28.2",
    "postgres": "^3.4.5",
    "stripe": "^17.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
